# Copiá este archivo a .env.local y completá lo que uses.
# .env.local está en .gitignore: nunca se commitea.

# --- Google Calendar -------------------------------------------------------
# Alcanza con una de las dos rutas (ver README).

# ID del calendario. Si no lo definís, usa el del proyecto.
GOOGLE_CALENDAR_ID=

# Ruta A · calendario privado, service account (recomendada)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Ruta B · calendario público, API key
GOOGLE_CALENDAR_API_KEY=

# --- Modelo ----------------------------------------------------------------
# Hay dos caminos, y sólo hace falta uno.

# A) Suscripción de claude.ai (Pro/Max), vía el Agent SDK. Sólo local: necesita
#    el binario de Claude Code en la máquina. No gasta créditos de API.
#    Apuntá al config dir del login que quieras usar; si lo dejás vacío, usa
#    el default (~/.claude). Verificá con: npm run check:agent
CLAUDE_CONFIG_DIR=

# B) API key de Anthropic, vía el SDK de la API. Funciona en cualquier lado,
#    incluido Vercel, y consume créditos. Verificá con: npm run check:anthropic
ANTHROPIC_API_KEY=
